aws_region                      = "eu-west-1"
availability_zone               = "eu-west-1a"
enable_serverless               = true
serverless_site_bucket_name    = "replace-with-unique-site-bucket"
cognito_domain_prefix          = "replace-with-unique-prefix"
serverless_site_base_url       = "https://replace-after-first-deploy-with-cloudfront-domain"
serverless_alert_email         = "operator@example.com"
enquiry_notification_email     = ""
enable_serverless_budget_alert = false
serverless_budget_email        = ""
serverless_budget_limit_usd    = 5
serverless_reserved_concurrency = 2
lambda_package_path            = "../../dist/serverless-lambda.zip"
application_version            = "replace-with-full-commit-sha"
contact_email                  = ""
contact_phone                  = ""
whatsapp_number                = ""
facebook_url                   = ""
instagram_url                  = ""
tiktok_url                     = ""
